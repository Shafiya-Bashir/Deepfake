<mxfile host="app.diagrams.net" agent="DeepFake-AI Antigravity" version="24.0.0" type="device"><diagram id="diag_MesoNetArchitecture" name="MesoNetArchitecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="880" background="#0a0f1d" math="1" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="node_2" value="&lt;b&gt;Meso-4 Input &amp;amp; Conv1-2&lt;/b&gt;&lt;br&gt;&lt;i style='color:#94a3b8;'&gt;Low-Level Analysis&lt;/i&gt;&lt;hr style='border-color:#1e293b;'&gt;• Input: 3 x 256 x 256&lt;br&gt;• Block 1:&lt;br&gt;    Conv2d(3→8, k=3, p=1)&lt;br&gt;    BatchNorm2d(8) + ReLU&lt;br&gt;    MaxPool2d(2, 2)&lt;br&gt;• Block 2:&lt;br&gt;    Conv2d(8→8, k=5, p=2)&lt;br&gt;    BatchNorm2d(8) + ReLU&lt;br&gt;    MaxPool2d(2, 2)&lt;br&gt;&lt;span style='color:#38bdf8;font-weight:bold;'&gt;[8x64x64]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141e33;strokeColor=#38bdf8;strokeWidth=2;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="130" width="190" height="320" /></mxCell><mxCell id="node_3" value="&lt;b&gt;Meso-4 Conv3-4&lt;/b&gt;&lt;br&gt;&lt;i style='color:#94a3b8;'&gt;Mid-Level Features&lt;/i&gt;&lt;hr style='border-color:#1e293b;'&gt;• Block 3:&lt;br&gt;    Conv2d(8→16, k=5, p=2)&lt;br&gt;    BatchNorm2d(16) + ReLU&lt;br&gt;    MaxPool2d(2, 2)&lt;br&gt;• Block 4:&lt;br&gt;    Conv2d(16→16, k=5, p=2)&lt;br&gt;    BatchNorm2d(16) + ReLU&lt;br&gt;    MaxPool2d(2, 2)&lt;br&gt;• Output: 16 x 14 x 14&lt;br&gt;&lt;span style='color:#818cf8;font-weight:bold;'&gt;[16x14x14]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141e33;strokeColor=#818cf8;strokeWidth=2;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="250" y="130" width="190" height="320" /></mxCell><mxCell id="node_4" value="&lt;b&gt;Meso-4 Dense Head&lt;/b&gt;&lt;br&gt;&lt;i style='color:#94a3b8;'&gt;Fully Connected Layers&lt;/i&gt;&lt;hr style='border-color:#1e293b;'&gt;• Flattening: 16*14*14 = 3136&lt;br&gt;• Linear(3136 → 16)&lt;br&gt;• ReLU Activation&lt;br&gt;• Dropout(p = 0.50)&lt;br&gt;• Linear(16 → 2)&lt;br&gt;• Binary Classification Logits&lt;br&gt;&lt;span style='color:#34d399;font-weight:bold;'&gt;[Meso-4 Output]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#062e1e;strokeColor=#34d399;strokeWidth=2;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="460" y="130" width="200" height="320" /></mxCell><mxCell id="edge_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#38bdf8;strokeWidth=2;fontColor=#38bdf8;fontSize=10;" edge="1" parent="1" source="node_2" target="node_3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#818cf8;strokeWidth=2;fontColor=#818cf8;fontSize=10;" edge="1" parent="1" source="node_3" target="node_4"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="node_7" value="&lt;b&gt;Inception Modules 1-2&lt;/b&gt;&lt;br&gt;&lt;i style='color:#94a3b8;'&gt;Multi-Kernel Convolutions&lt;/i&gt;&lt;hr style='border-color:#1e293b;'&gt;• Parallel Multi-Scale Kernels:&lt;br&gt;    1x1 Conv (Channel Compression)&lt;br&gt;    3x3 Conv (Local Gradients)&lt;br&gt;    5x5 Conv (Mesoscopic Patches)&lt;br&gt;• Inception 1: 3 → 16 channels&lt;br&gt;• MaxPool2d(2, 2)&lt;br&gt;• Inception 2: 16 → 32 channels&lt;br&gt;• MaxPool2d(2, 2)&lt;br&gt;&lt;span style='color:#a855f7;font-weight:bold;'&gt;[Inception Blocks]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141e33;strokeColor=#a855f7;strokeWidth=2;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="720" y="130" width="290" height="320" /></mxCell><mxCell id="node_8" value="&lt;b&gt;Conv3 &amp;amp; Dense Classifier&lt;/b&gt;&lt;br&gt;&lt;i style='color:#94a3b8;'&gt;Adaptive Pooling &amp;amp; Decision&lt;/i&gt;&lt;hr style='border-color:#1e293b;'&gt;• Conv3: Conv2d(32→64, k=3, p=1)&lt;br&gt;• AdaptiveAvgPool2d((7, 7))&lt;br&gt;• Flattening: 64 * 7 * 7 = 3136&lt;br&gt;• Dropout(p = 0.50)&lt;br&gt;• Linear(3136 → 64) + ReLU&lt;br&gt;• Linear(64 → 2)&lt;br&gt;• Output Softmax Probabilities&lt;br&gt;&lt;span style='color:#34d399;font-weight:bold;'&gt;[MesoInception Head]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#062e1e;strokeColor=#34d399;strokeWidth=2;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1050" y="130" width="290" height="320" /></mxCell><mxCell id="edge_9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#a855f7;strokeWidth=2;fontColor=#a855f7;fontSize=10;" edge="1" parent="1" source="node_7" target="node_8"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="node_10" value="&lt;b&gt;Comparative Forensic Evaluation &amp;amp; Architectural Analysis&lt;/b&gt;&lt;br&gt;&lt;i style='color:#94a3b8;'&gt;MesoNet Suite Tradeoffs&lt;/i&gt;&lt;hr style='border-color:#1e293b;'&gt;• Meso-4 Structural Advantage: Ultra-lightweight (27,970 parameters), minimal compute overhead, ideal for edge IoT microcontrollers.&lt;br&gt;• MesoInception-4 Advantage: Inception blocks capture multi-scale facial warping artifacts simultaneously across varying compression rates.&lt;br&gt;• Limitation: Susceptible to high compression blur (c40 degradation) due to lack of explicit frequency/wavelet decomposition.&lt;br&gt;• Resolution in DeepFake-AI: MesoNet backbones are used as lightweight base estimators inside our Calibrated Stacking Ensemble.&lt;br&gt;• Benchmark Performance (FaceForensics++ c23): Meso-4 AUC = 0.842 | MesoInception-4 AUC = 0.887 | ST2-SyncNet (Ours) AUC = 0.9995&lt;br&gt;&lt;span style='color:#fbbf24;font-weight:bold;'&gt;[MesoNet vs ST2-SyncNet]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141e33;strokeColor=#fbbf24;strokeWidth=2;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="500" width="1300" height="300" /></mxCell></root></mxGraphModel></diagram></mxfile>