<mxfile host="app.diagrams.net" agent="DeepFake-AI Antigravity" version="24.0.0" type="device"><diagram id="diag_DiffusionDetectorArchitecture" name="DiffusionDetectorArchitecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="800" background="#0a0f1d" math="1" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="node_2" value="&lt;b&gt;Query Image Input&lt;/b&gt;&lt;br&gt;&lt;i style='color:#94a3b8;'&gt;Face / Synthetic Media&lt;/i&gt;&lt;hr style='border-color:#1e293b;'&gt;• Input: 3 x 256 x 256&lt;br&gt;• Diffusion Model Generation:&lt;br&gt;    - Stable Diffusion XL&lt;br&gt;    - Midjourney v6&lt;br&gt;    - DALL-E 3&lt;br&gt;• High-Frequency Inpainting Seams&lt;br&gt;• Reverse Process Noise Residuals&lt;br&gt;&lt;span style='color:#38bdf8;font-weight:bold;'&gt;[[B, 3, 256, 256]]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141e33;strokeColor=#38bdf8;strokeWidth=2;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="220" width="260" height="320" /></mxCell><mxCell id="node_3" value="&lt;b&gt;High-Pass Residual Extraction&lt;/b&gt;&lt;br&gt;&lt;i style='color:#94a3b8;'&gt;Noise Discrepancy ε = |I - Î|&lt;/i&gt;&lt;hr style='border-color:#1e293b;'&gt;• Reconstruction Filter: Î = D(I)&lt;br&gt;• Denoising Score Discrepancy:&lt;br&gt;    ε = | I - Î |&lt;br&gt;• Convolutional Residual Stem:&lt;br&gt;    Conv2d(3→32, k=3, p=1)&lt;br&gt;    ReLU(inplace=True)&lt;br&gt;    MaxPool2d(kernel_size=2)&lt;br&gt;• Isolates non-biological lattice noise&lt;br&gt;• Output: [B, 32, 128, 128]&lt;br&gt;&lt;span style='color:#818cf8;font-weight:bold;'&gt;[Residual Stem]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141e33;strokeColor=#818cf8;strokeWidth=2;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="180" width="340" height="400" /></mxCell><mxCell id="node_4" value="&lt;b&gt;Deep Residual Feature Extractor&lt;/b&gt;&lt;br&gt;&lt;i style='color:#94a3b8;'&gt;Lattice Checkerboard Detection&lt;/i&gt;&lt;hr style='border-color:#1e293b;'&gt;• Deep Conv Layer:&lt;br&gt;    Conv2d(32→64, k=3, p=1)&lt;br&gt;    ReLU(inplace=True)&lt;br&gt;• Global Spatial Pool:&lt;br&gt;    AdaptiveAvgPool2d((1, 1))&lt;br&gt;• Feature Flattening: R^[B, 64]&lt;br&gt;• Exposes synthetic Markovian sampling anomalies&lt;br&gt;&lt;span style='color:#c084fc;font-weight:bold;'&gt;[f_dire ∈ R^64]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141e33;strokeColor=#c084fc;strokeWidth=2;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="720" y="180" width="300" height="400" /></mxCell><mxCell id="node_5" value="&lt;b&gt;Dense Classifier&lt;/b&gt;&lt;br&gt;&lt;i style='color:#94a3b8;'&gt;Authentic vs Diffusion&lt;/i&gt;&lt;hr style='border-color:#1e293b;'&gt;• Linear(64 → 2)&lt;br&gt;• Softmax Logits:&lt;br&gt;    P(Organic) vs P(Diffusion)&lt;br&gt;• High Generalization on Unseen Checkpoints&lt;br&gt;&lt;span style='color:#34d399;font-weight:bold;'&gt;[Binary Softmax]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#062e1e;strokeColor=#34d399;strokeWidth=2;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="260" width="180" height="240" /></mxCell><mxCell id="edge_6" value="Residual Tensor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#818cf8;strokeWidth=2;fontColor=#818cf8;fontSize=10;" edge="1" parent="1" source="node_3" target="node_4"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>