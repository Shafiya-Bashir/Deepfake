<mxfile host="app.diagrams.net" agent="DeepFake-AI Antigravity" version="24.0.0" type="device"><diagram id="diag_XceptionArchitecture" name="XceptionArchitecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="820" background="#0a0f1d" math="1" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="node_2" value="&lt;b&gt;Face Crop Input&lt;/b&gt;&lt;br&gt;&lt;i style='color:#94a3b8;'&gt;Facial Region of Interest&lt;/i&gt;&lt;hr style='border-color:#1e293b;'&gt;• Input Dimensions: 3 x 299 x 299&lt;br&gt;• RGB Normalized&lt;br&gt;• FaceForensics++ Alignment&lt;br&gt;• Benchmark Standard&lt;br&gt;&lt;span style='color:#38bdf8;font-weight:bold;'&gt;[[B, 3, 299, 299]]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141e33;strokeColor=#38bdf8;strokeWidth=2;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="250" width="230" height="240" /></mxCell><mxCell id="node_3" value="&lt;b&gt;Entry Flow Stem&lt;/b&gt;&lt;br&gt;&lt;i style='color:#94a3b8;'&gt;Initial Feature Mapping&lt;/i&gt;&lt;hr style='border-color:#1e293b;'&gt;• Conv2d(3→32, k=3, s=2, p=1, bias=False)&lt;br&gt;• BatchNorm2d(32) + ReLU&lt;br&gt;• Conv2d(32→64, k=3, p=1, bias=False)&lt;br&gt;• BatchNorm2d(64) + ReLU&lt;br&gt;• Maps low-level pixel color discontinuities&lt;br&gt;• Output Spatial Dimension: [B, 64, 150, 150]&lt;br&gt;&lt;span style='color:#818cf8;font-weight:bold;'&gt;[[B, 64, 150, 150]]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141e33;strokeColor=#818cf8;strokeWidth=2;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="310" y="180" width="320" height="380" /></mxCell><mxCell id="node_4" value="&lt;b&gt;Depthwise Separable Blocks&lt;/b&gt;&lt;br&gt;&lt;i style='color:#94a3b8;'&gt;Decoupled Spatial &amp;amp; Channel Convolutions&lt;/i&gt;&lt;hr style='border-color:#1e293b;'&gt;• Block 1 (64 → 128):&lt;br&gt;    Depthwise Conv2d(64→64, k=3, groups=64)&lt;br&gt;    Pointwise Conv2d(64→128, k=1)&lt;br&gt;    BatchNorm2d(128) + ReLU&lt;br&gt;    MaxPool2d(kernel_size=2)&lt;br&gt;• Block 2 (128 → 256):&lt;br&gt;    Depthwise Conv2d(128→128, k=3, groups=128)&lt;br&gt;    Pointwise Conv2d(128→256, k=1)&lt;br&gt;    BatchNorm2d(256) + ReLU&lt;br&gt;    AdaptiveAvgPool2d((1, 1))&lt;br&gt;• Decouples spatial correlation from cross-channel correlation&lt;br&gt;&lt;span style='color:#c084fc;font-weight:bold;'&gt;[f_xception ∈ R^256]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#141e33;strokeColor=#c084fc;strokeWidth=2;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="670" y="150" width="340" height="440" /></mxCell><mxCell id="node_5" value="&lt;b&gt;Exit Flow &amp;amp; Classification&lt;/b&gt;&lt;br&gt;&lt;i style='color:#94a3b8;'&gt;Binary Face Authenticity&lt;/i&gt;&lt;hr style='border-color:#1e293b;'&gt;• Flattening: 256-dim Feature Vector&lt;br&gt;• Dropout(p = 0.50)&lt;br&gt;• Fully-Connected Head: Linear(256 → 2)&lt;br&gt;• Binary Classification Softmax&lt;br&gt;• Fast Execution: 3.2ms on GPU&lt;br&gt;&lt;span style='color:#34d399;font-weight:bold;'&gt;[Softmax Logits]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#062e1e;strokeColor=#34d399;strokeWidth=2;fontColor=#ffffff;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1050" y="220" width="290" height="300" /></mxCell><mxCell id="edge_6" value="[B, 64, 150, 150]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#818cf8;strokeWidth=2;fontColor=#818cf8;fontSize=10;" edge="1" parent="1" source="node_3" target="node_4"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_7" value="256-D Features" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c084fc;strokeWidth=2;fontColor=#c084fc;fontSize=10;" edge="1" parent="1" source="node_4" target="node_5"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>